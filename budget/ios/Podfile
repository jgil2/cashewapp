# Set the platform to 13.0 to match your current build logs
platform :ios, '13.0'

# CocoaPods analytics are sometimes useful but not required
install! 'cocoapods', :deterministic_uuids => false

target 'Runner' do
  use_frameworks!
  use_modular_headers!

  flutter_install_all_ios_pods File.dirname(File.realpath(__FILE__))

  # If you have specific pods that aren't being picked up by Flutter, 
  # you can add them here.
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    flutter_additional_ios_build_settings(target)
    
    # 1. FIX FOR gRPC-Core: Resolves the "A template argument list is expected" error
    if target.name == 'gRPC-Core'
      target.build_configurations.each do |config|
        config.build_settings['GCC_PREPROCESSOR_DEFINITIONS'] ||= ['$(inherited)', 'GRPC_BAZEL_BUILD=1']
      end
    end

    # 2. ENSURE CONSISTENT DEPLOYMENT TARGET: 
    # Prevents "Minimum iOS deployment target" warnings and conflicts
    target.build_configurations.each do |config|
      config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '13.0'
    end
  end
end
